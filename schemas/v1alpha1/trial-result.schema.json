{
  "$defs": {
    "AdapterInfo": {
      "additionalProperties": false,
      "description": "Portable identity for the adapter used by a trial.",
      "properties": {
        "kind": {
          "default": "python",
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "qualname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualname"
        }
      },
      "required": [
        "name"
      ],
      "title": "AdapterInfo",
      "type": "object"
    },
    "AgentRun": {
      "additionalProperties": false,
      "properties": {
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "output": {
          "default": "",
          "title": "Output",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "blocked",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "AgentRun",
      "type": "object"
    },
    "ContractReport": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "violations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContractViolation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "passed"
      ],
      "title": "ContractReport",
      "type": "object"
    },
    "ContractViolation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "contract": {
          "minLength": 1,
          "title": "Contract",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message",
        "contract"
      ],
      "title": "ContractViolation",
      "type": "object"
    },
    "EventKind": {
      "enum": [
        "agent",
        "read",
        "policy",
        "tool_call",
        "commit",
        "idempotency_hit",
        "fault",
        "error"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "FailureCategory": {
      "description": "High-level ownership category for a runner lifecycle failure.",
      "enum": [
        "infrastructure",
        "agent",
        "contract",
        "artifact"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "FailureStage": {
      "description": "Runner lifecycle stage at which a structured failure occurred.",
      "enum": [
        "world_creation",
        "initial_snapshot",
        "agent_execution",
        "final_snapshot",
        "contract_evaluation",
        "cleanup",
        "artifact_generation"
      ],
      "title": "FailureStage",
      "type": "string"
    },
    "FaultMode": {
      "description": "Where a simulated failure occurs relative to a business commit.",
      "enum": [
        "timeout_before",
        "timeout_after_commit"
      ],
      "title": "FaultMode",
      "type": "string"
    },
    "FaultRule": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/FaultMode"
        },
        "occurrence": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "mode"
      ],
      "title": "FaultRule",
      "type": "object"
    },
    "JsonValue": {},
    "LifecycleFailure": {
      "additionalProperties": false,
      "description": "Typed failure captured while the runner advances through its lifecycle.",
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "exception_type": {
          "minLength": 1,
          "title": "Exception Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "primary": {
          "title": "Primary",
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/FailureStage"
        }
      },
      "required": [
        "stage",
        "category",
        "exception_type",
        "message",
        "primary"
      ],
      "title": "LifecycleFailure",
      "type": "object"
    },
    "TestCase": {
      "additionalProperties": false,
      "description": "Portable input to one agent trial.\n\n``world`` contains domain-specific initial state. The framework deliberately\nkeeps this as JSON so adapters can target databases, HTTP sandboxes, MCP\nservers, or in-memory fakes without inheriting a framework data model.",
      "properties": {
        "actor": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Actor",
          "type": "object"
        },
        "faults": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FaultRule"
          },
          "title": "Faults",
          "type": "array"
        },
        "goal": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Goal",
          "type": "object"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "schema_version": {
          "const": "agent-effects.case/v1alpha1",
          "default": "agent-effects.case/v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "subject": {
          "default": "unspecified",
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "world": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "World",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "TestCase",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "kind",
        "operation"
      ],
      "title": "TraceEvent",
      "type": "object"
    }
  },
  "$id": "https://schemas.agent-effects.dev/v1alpha1/trial-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdapterInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "agent_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Path"
    },
    "case": {
      "$ref": "#/$defs/TestCase"
    },
    "contract_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Contract Ids",
      "type": "array"
    },
    "contracts": {
      "$ref": "#/$defs/ContractReport"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "number"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "final_state": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Final State"
    },
    "initial_state": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Initial State"
    },
    "lifecycle_failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LifecycleFailure"
      },
      "title": "Lifecycle Failures",
      "type": "array"
    },
    "reproducer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproducer Id"
    },
    "schema_version": {
      "const": "agent-effects.result/v1alpha1",
      "default": "agent-effects.result/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "case",
    "agent_name",
    "initial_state",
    "final_state",
    "events",
    "agent_run",
    "contracts",
    "elapsed_ms"
  ],
  "title": "TrialResult",
  "type": "object",
  "x-agent-effects-schema-version": "v1alpha1"
}
