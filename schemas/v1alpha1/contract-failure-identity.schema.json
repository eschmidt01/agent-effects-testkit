{
  "$id": "https://schemas.agent-effects.dev/v1alpha1/contract-failure-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stable identity and multiplicity for one kind of contract violation.",
  "properties": {
    "contract_id": {
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "count": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "violation_code": {
      "minLength": 1,
      "title": "Violation Code",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "violation_code"
  ],
  "title": "ContractFailureIdentity",
  "type": "object",
  "x-agent-effects-schema-version": "v1alpha1"
}
