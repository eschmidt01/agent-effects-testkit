{
  "$defs": {
    "ContractViolation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "contract": {
          "minLength": 1,
          "title": "Contract",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message",
        "contract"
      ],
      "title": "ContractViolation",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "https://schemas.agent-effects.dev/v1alpha1/contract-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "violations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContractViolation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "passed"
  ],
  "title": "ContractReport",
  "type": "object",
  "x-agent-effects-schema-version": "v1alpha1"
}
